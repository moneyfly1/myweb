# ============================================================
# CBoard - 环境变量配置模板
# 复制为 .env 并按需修改：cp .env.example .env
# 修改后重启服务生效：systemctl restart cboard
# 注意：SECRET_KEY 必须修改为强随机字符串，切勿使用默认值！
# ============================================================

# ---------- 基础配置 ----------
# 监听地址与端口（Docker 部署时端口需与 docker-compose.yml 映射一致）
HOST=0.0.0.0
PORT=8000
# 调试模式：true 时输出更详细日志（生产环境请设为 false）
DEBUG=false
# 应用名称与版本
PROJECT_NAME=CBoard Modern
VERSION=1.0.0
API_V1_STR=/api/v1
# 环境：production 会强制要求强密钥；留空则视为开发环境
ENV=production

# ---------- 数据库 ----------
# 默认使用 SQLite（文件在项目根目录 cboard.db）
# 使用 MySQL：mysql://user:password@host:3306/dbname?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai
# 使用 PostgreSQL：postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=sqlite:///./cboard.db
# 或通过独立变量配置 MySQL（DATABASE_URL 含 mysql 时优先）
# USE_MYSQL=true
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=cboard_user
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=cboard_db
# PostgreSQL 独立变量
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=cboard

# ---------- 安全（重要！）----------
# JWT 签名密钥：必须为至少 32 字节的强随机串（生产环境弱密钥会拒绝启动）
# 生成方式：openssl rand -hex 32
SECRET_KEY=请替换为openssl-rand-hex-32生成的强随机字符串
# 也可以使用 JWT_SECRET_KEY 环境变量（优先级更高）
# JWT_SECRET_KEY=
# JWT 算法（HS256）与令牌有效期
JWT_ALGORITHM=HS256
# 访问令牌有效期（小时）
JWT_EXPIRE_HOURS=1
# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- 管理员账户 ----------
# 服务启动时自动创建/更新管理员（首次创建，之后每次启动校验密码）
# 不配置时使用默认值：admin / admin@example.com / admin123
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请替换为强密码

# ---------- 邮件服务（SMTP）----------
# 用于发送验证码、订单通知、到期提醒等邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_FROM_NAME=CBoard Modern
# 加密方式：tls（587 端口）/ ssl（465 端口）/ none
SMTP_ENCRYPTION=tls

# ---------- 支付宝当面付 ----------
# 需在支付宝开放平台签约「当面付」并应用上线
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=your-app-private-key
# ALIPAY_PUBLIC_KEY=your-alipay-public-key
# ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payment/notify/alipay
# ALIPAY_RETURN_URL=https://your-domain.com/payment/return

# ---------- Redis 缓存（可选，推荐生产开启）----------
# 配置后启用：支付方式列表/订阅配置/GeoIP 等缓存加速
REDIS_ADDR=localhost:6379

# ---------- GeoIP 地理位置数据库（可选）----------
# 不配置则使用项目根目录的 GeoLite2-City.mmdb；可指定自定义路径
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb

# ---------- 可信代理（反代后获取真实 IP）----------
# 部署在 Nginx/Caddy/Cloudflare 之后必须配置，否则用户 IP 会被记录为 127.0.0.1
# 多个用英文逗号分隔；Cloudflare 用户建议包含其 IP 段（103.21.244.0/22 等）
TRUSTED_PROXIES=127.0.0.1,::1

# ---------- CORS 跨域（前端开发/独立部署时用）----------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8080

# ---------- 上传与资源 ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---------- 订阅与设备 ----------
# 订阅链接前缀（自定义域名时设置，如 https://your-domain.com）
# SUBSCRIPTION_URL_PREFIX=https://your-domain.com
# 默认设备数限制
DEVICE_LIMIT_DEFAULT=3

# ---------- 设备升级价格（元/月、元/年）----------
DEVICE_UPGRADE_PRICE_PER_MONTH=10.0
DEVICE_UPGRADE_PRICE_PER_YEAR=200.0
DEVICE_UPGRADE_BASE_DEVICES=5

# ---------- 调度任务 ----------
# 是否禁用定时任务（节点健康检查、流量配额检查、备份等）。生产留 false
DISABLE_SCHEDULE_TASKS=false
# 低配服务器优化（降低部分任务频率/并发）
OPTIMIZE_FOR_LOW_END=true

# ---------- 性能 ----------
WORKERS=4

# ---------- 自建节点面板回传地址 ----------
# 自建节点部署时节点 VPS 回传/心跳访问的面板公网地址（生产必配）
# 不配置时自动从请求推导
# PANEL_PUBLIC_URL=https://your-domain.com

# ============================================================
# 前端构建配置（frontend/.env 或 .env.production）
# VITE_API_BASE_URL=https://your-domain.com
# 生产环境前端默认与后端同域（Nginx 反代），通常无需额外配置
# ============================================================
