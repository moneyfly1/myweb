# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.backup

# Database（不提交到仓库，首次运行或安装脚本会自动创建）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# GeoIP Database (自动下载，不提交到仓库)
GeoLite2-City.mmdb

# Logs
*.log
logs/
# 管理后台日志管理子组件（需纳入版本控制）
!frontend/src/views/admin/logs/

# Uploads
uploads/
static/uploads/

# Build output
dist/
build/
bin/
server

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.pid
*.zip
*.bak
*.backup
*.backup.*
.playwright-cli/
output/
cboard-server
cboard-go

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Other projects
cboard 网站/
create_admin
unlock_user
update_admin_password
main

# Local helper module for running scripts without affecting root build
scripts/go.mod
scripts/go.sum
dbip-city-lite.mmdb
cboard

# local go build cache (sandbox)
.gocache/


.pantest/


# linux 交叉编译产物（部署用，不入库）
server-linux

# 运维 CLI 产物（按约定构建到项目根目录，便于就近解析相对 DB 路径，不入库）
domain_pool


# 数据库损坏备份（含敏感数据，不入库）
*.db.corrupt.*
*.db.bak.*
cboard.db.*.bak.*

# SSH askpass 临时脚本（含服务器密码，严禁入库）
.askpass.sh
.gomodcache/
audit-moneyfly/
.gopath/

# pi 插件本地配置（含密钥，勿提交）
.pi/

# 前端构建时自动生成的类型声明（unplugin-vue-components / 曾经用过的 unplugin-auto-import）
# 这两个文件由 vite 构建过程重写，不入库，避免每次构建都产生无意义 diff
frontend/components.d.ts
frontend/auto-imports.d.ts

# Python 字节码（脚本目录下运行会生成，不入库）
__pycache__/
*.pyc
